<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#111827">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="♿"
            android:textSize="26sp"
            android:gravity="center"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Serviço de Acessibilidade"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogAccessibilityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Desativado"
                android:textColor="#EF4444"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Explicação do que se trata (Prominent Disclosure) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="#334155"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="ℹ️ Do que se trata (Google Play Policy):\nO KMCERTO necessita do Serviço de Acessibilidade unicamente para detetar o valor, distância e tempo nos ecrãs das ofertas do iFood, Uber e 99 enquanto você dirige. Nenhum dado pessoal, palavra-passe ou mensagem privada é lido, gravado ou compartilhado com terceiros."
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Botão Abrir Configurações do Android -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogManageAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ativar / Gerenciar Acessibilidade"
        android:textColor="#000000"
        android:textStyle="bold"
        app:backgroundTint="#00E676"
        app:cornerRadius="10dp" />

</LinearLayout>
