<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="#111827">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🛡️"
                android:textSize="26sp"
                android:gravity="center"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filtros Anti-Prejuízo"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proteção contra corridas ruins"
                    android:textColor="#F59E0B"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Explicação do que se trata -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#334155"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="ℹ️ Do que se trata:\nOs filtros anti-prejuízo garantem que você nunca faça corridas que pagam mixaria, corridas longas demais que te jogam para longe da sua área ou viagens cujo retorno vazio consome todo o seu lucro. Se a corrida violar qualquer um destes limites, ela vai direto para VERMELHO."
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Piso Mínimo de Valor Bruto -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDialogMinGrossValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Piso Mínimo da Corrida"
            android:textColorHint="#9CA3AF"
            app:hintTextColor="#F59E0B"
            app:boxStrokeColor="#F59E0B"
            app:boxBackgroundColor="#1E293B"
            app:prefixText="R$ "
            app:prefixTextColor="#F59E0B"
            app:helperText="Corridas abaixo deste valor vão para Vermelho (0 desativa). Ex: 7,00"
            app:helperTextTextColor="#9CA3AF"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogMinGrossValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:text="0,00" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Teto Máximo de Distância -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDialogMaxDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Teto de Distância Máxima"
            android:textColorHint="#9CA3AF"
            app:hintTextColor="#F59E0B"
            app:boxStrokeColor="#F59E0B"
            app:boxBackgroundColor="#1E293B"
            app:suffixText=" km"
            app:suffixTextColor="#F59E0B"
            app:helperText="Corridas acima deste km vão para Vermelho (0 desativa). Ex: 15.0"
            app:helperTextTextColor="#9CA3AF"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogMaxDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:text="0.0" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Volta Vazia / Retorno (%) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDialogEmptyReturnPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Retorno Vazio / Volta"
            android:textColorHint="#9CA3AF"
            app:hintTextColor="#F59E0B"
            app:boxStrokeColor="#F59E0B"
            app:boxBackgroundColor="#1E293B"
            app:suffixText=" %"
            app:suffixTextColor="#F59E0B"
            app:helperText="Adiciona % extra de km e tempo de retorno no custo real (ex: 20%)"
            app:helperTextTextColor="#9CA3AF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogEmptyReturnPercent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:text="0" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
