<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="#111827">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🛵"
                android:textSize="26sp"
                android:gravity="center"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custos Operacionais &amp; Metas"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consumo, manutenção e valor/hora"
                    android:textColor="#00E676"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Explicação do que se trata -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#334155"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="ℹ️ Do que se trata:\nO KMCERTO desconta o combustível exato e o desgaste (pneu, óleo, freios) em cada corrida para te mostrar quanto realmente sobra no seu bolso. Com base nas suas metas de R$/km e R$/hora, ele define se o pedido compensa (Verde) ou dá prejuízo (Vermelho)."
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Seleção do Veículo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de Veículo"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgDialogVehicleType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <RadioButton
                android:id="@+id/rbDialogMoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛵 Moto"
                android:textColor="#FFFFFF"
                app:buttonTint="#00E676"
                android:checked="true"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rbDialogBike"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚲 Bike"
                android:textColor="#FFFFFF"
                app:buttonTint="#00E676"
                android:textSize="15sp" />
        </RadioGroup>

        <!-- Alerta de Subida Forte para Bike -->
        <LinearLayout
            android:id="@+id/layoutDialogBikeElevation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E293B"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="🚴"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alerta de Subida Forte (Bike)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Penaliza corridas com morros/serras íngremes"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swDialogBikeElevation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="#00E676"
                app:trackTint="#334155" />
        </LinearLayout>

        <!-- Preço do Combustível -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDialogFuelPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Preço do Litro do Combustível"
            android:textColorHint="#9CA3AF"
            app:hintTextColor="#00E676"
            app:boxStrokeColor="#00E676"
            app:boxBackgroundColor="#1E293B"
            app:prefixText="R$ "
            app:prefixTextColor="#00E676"
            app:helperText="Ex: 5,80 por litro"
            app:helperTextTextColor="#9CA3AF"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogFuelPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:text="5.80" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sincronização Preço Médio ANP -->
        <LinearLayout
            android:id="@+id/layoutDialogFuelAnpSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDialogFuelStateCode"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:hint="UF"
                android:textColorHint="#9CA3AF"
                app:hintTextColor="#00E676"
                app:boxStrokeColor="#00E676"
                app:boxBackgroundColor="#1E293B">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDialogFuelStateCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLength="2"
                    android:textColor="#FFFFFF"
                    android:text="SP" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogSyncFuelPrice"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="⛽ Buscar Média ANP"
                android:textColor="#00E676"
                app:strokeColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Consumo Médio -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDialogFuelConsumption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Consumo Médio do Veículo"
            android:textColorHint="#9CA3AF"
            app:hintTextColor="#00E676"
            app:boxStrokeColor="#00E676"
            app:boxBackgroundColor="#1E293B"
            app:suffixText=" km/l"
            app:suffixTextColor="#00E676"
            app:helperText="Ex: 35,0 km por litro"
            app:helperTextTextColor="#9CA3AF"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogFuelConsumption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:text="35.0" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Custo de Manutenção por Km -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDialogMaintenanceCost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custo de Manutenção / Desgaste"
            android:textColorHint="#9CA3AF"
            app:hintTextColor="#00E676"
            app:boxStrokeColor="#00E676"
            app:boxBackgroundColor="#1E293B"
            app:prefixText="R$ "
            app:prefixTextColor="#00E676"
            app:suffixText=" /km"
            app:suffixTextColor="#9CA3AF"
            app:helperText="Óleo, pneus, freios, relação. Ex: 0,12"
            app:helperTextTextColor="#9CA3AF"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogMaintenanceCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:text="0.12" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tempo de Espera Restaurante -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDialogWaitBuffer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Espera Estimada no Restaurante"
            android:textColorHint="#9CA3AF"
            app:hintTextColor="#00E676"
            app:boxStrokeColor="#00E676"
            app:boxBackgroundColor="#1E293B"
            app:suffixText=" min"
            app:suffixTextColor="#00E676"
            app:helperText="Tempo médio aguardando o pedido. Ex: 10"
            app:helperTextTextColor="#9CA3AF"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogWaitBuffer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:text="10" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Meta Mínima por Km -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDialogTargetKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Meta Líquida Mínima por Km"
            android:textColorHint="#9CA3AF"
            app:hintTextColor="#00E676"
            app:boxStrokeColor="#00E676"
            app:boxBackgroundColor="#1E293B"
            app:prefixText="R$ "
            app:prefixTextColor="#00E676"
            app:suffixText=" /km"
            app:suffixTextColor="#9CA3AF"
            app:helperText="Seu valor mínimo por km rodado. Ex: 2,00"
            app:helperTextTextColor="#9CA3AF"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogTargetKm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:text="2.00" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Meta Mínima por Hora -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDialogTargetHour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Meta Líquida Mínima por Hora"
            android:textColorHint="#9CA3AF"
            app:hintTextColor="#00E676"
            app:boxStrokeColor="#00E676"
            app:boxBackgroundColor="#1E293B"
            app:prefixText="R$ "
            app:prefixTextColor="#00E676"
            app:suffixText=" /h"
            app:suffixTextColor="#9CA3AF"
            app:helperText="Meta de lucro horário. Ex: 25,00"
            app:helperTextTextColor="#9CA3AF"
            android:layout_marginBottom="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogTargetHour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:text="25.00" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
